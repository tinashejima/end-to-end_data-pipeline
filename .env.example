# Environment configuration for error notifications
# Copy this file to .env and fill in your credentials

# SMTP Configuration (Gmail example)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password

# Recipient email(s) - comma-separated for multiple
RECIPIENT_EMAIL=recipient@example.com,another@example.com

# Prefect Configuration (for CI/CD)
PREFECT_API_KEY=your_prefect_api_key
PREFECT_ACCOUNT_ID=your_account_id
PREFECT_WORKSPACE_ID=your_workspace_id
